NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
# Public URL of this API, used in avatar and resume links (set it on your host, e.g. https://job-portal-g89w.onrender.com)
# BASE_URL=

# Social login (optional). A provider is enabled only when both its id and secret are set.
# See docs/SOCIAL_LOGIN.md for how to create the apps and which redirect URL to register.
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
